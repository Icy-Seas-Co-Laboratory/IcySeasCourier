{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icy Seas Courier",
  "version": "0.1.0",
  "identifier": "co.icyseas.courier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Icy Seas Courier",
        "width": 1080,
        "height": 760,
        "minWidth": 680,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

