# Copy to .env on the Courier host, chmod 600, and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=icy-seas-courier

REGISTRY_ENVIRONMENT=beta
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD
REGISTRY_ADMIN_API_KEY=CHANGE_ME_RANDOM_ADMIN_SECRET
REGISTRY_TOKEN_PEPPER=CHANGE_ME_RANDOM_TOKEN_PEPPER

AWS_ACCESS_KEY_ID=CHANGE_ME_SEAWEED_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SEAWEED_SECRET_KEY
REGISTRY_S3_BUCKET=icy-seas-incoming
REGISTRY_S3_PUBLIC_ENDPOINT_URL=https://s3.icyseascolab.io

REGISTRY_REQUIRE_HTTPS=true
REGISTRY_BIND_ADDRESS=127.0.0.1
REGISTRY_PORT=8020
SEAWEEDFS_BIND_ADDRESS=127.0.0.1
SEAWEEDFS_S3_PORT=8333

# The dedicated edge network gives Courier's loopback gateway a stable address.
# Change both values together if this subnet overlaps another Docker network.
COURIER_EDGE_SUBNET=172.30.50.0/24
COURIER_GATEWAY_IPV4_ADDRESS=172.30.50.10
REGISTRY_TRUSTED_PROXY_NETWORKS=172.30.50.10/32
REGISTRY_FORWARDED_ALLOW_IPS=127.0.0.1,172.30.50.10

# Admin routes remain limited to local and approved VPN clients even though the
# public Registry hostname is tunneled. Add only explicitly approved networks.
REGISTRY_ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,100.64.0.0/10

REGISTRY_HASH_ALGORITHM=sha256
REGISTRY_MAXIMUM_TRANSFER_FILES=100000
REGISTRY_MAXIMUM_REQUEST_BODY_BYTES=67108864
REGISTRY_AUTHENTICATION_REQUESTS_PER_MINUTE=30
REGISTRY_ADMIN_REQUESTS_PER_MINUTE=120
REGISTRY_CLIENT_REQUESTS_PER_MINUTE=600
REGISTRY_RATE_LIMIT_MAXIMUM_CLIENTS=2048

# Optional absolute host directory. Leave empty for the project-scoped volume.
SEAWEEDFS_DATA_PATH=
