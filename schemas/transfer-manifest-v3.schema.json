{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.icyseas.co/transfer-manifest-v3.schema.json",
  "title": "Icy Seas Transfer Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "transfer_id", "project", "created_at", "courier", "source", "summary", "transport_objects", "files"],
  "properties": {
    "schema": { "const": "icy-seas-transfer-manifest" },
    "version": { "const": 3 },
    "transfer_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "project": { "type": "string", "pattern": "^P[0-9]{5}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "courier": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "platform", "transport_encoding_version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "transport_encoding_version": { "const": 2 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 512 } }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["file_count", "original_bytes"],
      "properties": {
        "file_count": { "type": "integer", "minimum": 0 },
        "original_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "transport_objects": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "compression", "encoding_version", "original_bytes"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "enum": ["file", "pack"] },
          "compression": { "enum": ["none", "zstd"] },
          "encoding_version": { "type": "integer", "enum": [1, 2] },
          "original_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size", "mtime", "digest", "transport"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 4096, "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } },
          "size": { "type": "integer", "minimum": 0 },
          "mtime": { "type": "string", "format": "date-time" },
          "digest": {
            "type": "object", "additionalProperties": false,
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "enum": ["sha256", "xxhash3", "blake3"] },
              "value": { "type": "string", "pattern": "^[a-f0-9]+$", "minLength": 32, "maxLength": 64 }
            }
          },
          "transport": {
            "type": "object", "additionalProperties": false,
            "required": ["object_id", "member_index"],
            "properties": {
              "object_id": { "type": "string", "format": "uuid" },
              "member_index": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
