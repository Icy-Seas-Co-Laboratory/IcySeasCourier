{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.icyseas.co/transfer-manifest-v1.schema.json",
  "title": "Icy Seas Transfer Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "transfer_id", "project", "created_at", "courier", "source", "summary", "files"],
  "properties": {
    "schema": { "const": "icy-seas-transfer-manifest" },
    "version": { "const": 1 },
    "transfer_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "project": { "type": "string", "pattern": "^P[0-9]{5}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "courier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "platform", "transport_encoding_version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "transport_encoding_version": { "const": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 512 } }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "original_bytes"],
      "properties": {
        "file_count": { "type": "integer", "minimum": 0 },
        "original_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "mtime", "sha256", "transport"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 4096, "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } },
          "size": { "type": "integer", "minimum": 0 },
          "mtime": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "transport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["compression", "encoding_version"],
            "properties": {
              "compression": { "enum": ["none", "zstd"] },
              "encoding_version": { "const": 1 }
            }
          }
        }
      }
    }
  }
}

