COURIER_S3_ENDPOINT=http://127.0.0.1:8333
COURIER_S3_BUCKET=icy-seas-incoming
COURIER_S3_REGION=us-east-1
COURIER_REGISTRY_URL=http://127.0.0.1:8010
COURIER_HASH_ALGORITHM=sha256
# Development only. Courier will use Registry-issued short-lived authorization later.
AWS_ACCESS_KEY_ID=development
AWS_SECRET_ACCESS_KEY=development

# Data Registry development settings. Replace outside local development.
REGISTRY_ADMIN_API_KEY=development-only-change-me
REGISTRY_TOKEN_PEPPER=development-only-change-me-too
REGISTRY_DATABASE_URL=postgresql+psycopg://registry:registry@127.0.0.1:5432/registry
REGISTRY_SESSION_LIFETIME_SECONDS=3600
REGISTRY_REFRESH_LIFETIME_SECONDS=2592000
REGISTRY_S3_INTERNAL_ENDPOINT_URL=http://127.0.0.1:8333
REGISTRY_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:8333
REGISTRY_S3_BUCKET=icy-seas-incoming
REGISTRY_HASH_ALGORITHM=sha256
