COURIER_S3_ENDPOINT=http://127.0.0.1:8333
COURIER_S3_BUCKET=icy-seas-incoming
COURIER_S3_REGION=us-east-1
COURIER_REGISTRY_URL=http://127.0.0.1:8010
COURIER_HASH_ALGORITHM=sha256
# Development only. Courier will use Registry-issued short-lived authorization later.
AWS_ACCESS_KEY_ID=development
AWS_SECRET_ACCESS_KEY=development

# Data Registry development settings. Replace outside local development.
REGISTRY_ENVIRONMENT=development
POSTGRES_PASSWORD=registry
REGISTRY_ADMIN_API_KEY=development-only-change-me
REGISTRY_TOKEN_PEPPER=development-only-change-me-too
REGISTRY_DATABASE_URL=postgresql+psycopg://registry:registry@127.0.0.1:5432/registry
REGISTRY_SESSION_LIFETIME_SECONDS=3600
REGISTRY_REFRESH_LIFETIME_SECONDS=2592000
REGISTRY_S3_INTERNAL_ENDPOINT_URL=http://127.0.0.1:8333
REGISTRY_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:8333
REGISTRY_S3_BUCKET=icy-seas-incoming
REGISTRY_HASH_ALGORITHM=sha256
REGISTRY_MAXIMUM_TRANSFER_FILES=100000
REGISTRY_MAXIMUM_REQUEST_BODY_BYTES=67108864
REGISTRY_AUTHENTICATION_REQUESTS_PER_MINUTE=30
REGISTRY_ADMIN_REQUESTS_PER_MINUTE=120
REGISTRY_CLIENT_REQUESTS_PER_MINUTE=600
REGISTRY_RATE_LIMIT_MAXIMUM_CLIENTS=2048
REGISTRY_ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,100.64.0.0/16
# Only set this when a known reverse proxy supplies X-Forwarded-For.
REGISTRY_TRUSTED_PROXY_NETWORKS=
REGISTRY_REQUIRE_HTTPS=false
REGISTRY_BIND_ADDRESS=0.0.0.0
SEAWEEDFS_BIND_ADDRESS=0.0.0.0
# Optional absolute local directory for SeaweedFS data on a deployed server.
# Leave empty to use the Docker-managed seaweedfs-data volume for development.
SEAWEEDFS_DATA_PATH=
# Uvicorn proxy-header trust. For a reverse proxy, use only its immediate source IP/CIDR.
REGISTRY_FORWARDED_ALLOW_IPS=127.0.0.1
